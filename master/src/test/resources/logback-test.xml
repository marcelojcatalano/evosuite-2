<!-- During test execution, we do not want to have debug/info that would flood the logging -->

<!-- Usando la sintaxis moderna y variables de logback -->
<configuration>

    <!-- Define el appender una sola vez y le das un nombre descriptivo -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- Target System.out es el valor por defecto, así que se puede omitir si se quiere -->
        <target>System.out</target>
        <encoder>
            <!-- Un patrón más completo que el original, incluye hilo y un color opcional si usas logback-classic -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Configuración para el contexto de tests -->
    <contextName>ContextForTests</contextName>

    <!-- Define el nivel de logging global (ROOT) y hace referencia al appender por su nombre -->
    <root level="DEBUG">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- Ejemplo: Si quisieras un logger específico para una clase con nivel DEBUG (muy útil en tests) -->
    <!-- <logger name="com.mipaquete.MiClase" level="DEBUG" /> -->

</configuration>